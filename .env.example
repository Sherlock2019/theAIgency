# Copy to .env (gitignored). Same LLM variables as the Myweb repo.
# Claude is used when a key is set; otherwise local Ollama; otherwise the built-in template engine.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5

# Local models through Ollama:  ollama pull qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
ANALYZE_MODEL=qwen2.5:7b
